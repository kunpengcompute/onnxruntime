+#define ORT_ANNC_SKIP_IF_NOT_AARCH64()                                             \
+  do {                                                                            \
+    if (!IsAarch64Build()) {                                                      \
+      GTEST_SKIP() << "The ANNC FusedTensordotMatMul tests require an AArch64 build."; \
+    }                                                                             \
+  } while (false)
+

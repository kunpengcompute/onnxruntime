+  for (size_t i = 0; i < query.size(); ++i) {
+    query[i] = 0.007f * static_cast<float>(static_cast<int>(i % 23) - 11);
+  }
+  for (size_t i = 0; i < key.size(); ++i) {
+    key[i] = 0.009f * static_cast<float>(static_cast<int>(i % 41) - 20);

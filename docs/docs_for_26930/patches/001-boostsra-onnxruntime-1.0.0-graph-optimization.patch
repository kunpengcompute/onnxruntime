+
+#if !defined(__aarch64__)
+  GTEST_SKIP() << "The ANNC FusedTensordotMatMul CPU kernel is registered only for AArch64.";
+#else
+  OpTester test("FusedTensordotMatMul", 1, kMSDomain);
